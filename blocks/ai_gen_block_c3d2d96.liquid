{% doc %}
  @prompt
    GENERAME Marquees
    
    Enable animation
    Animation speed
    
    5
    The higher the number, the slower the animation.
    
    Element size
    
    1
    Color scheme
    Text
    
    Default
    Default
    Backgrounds and borders
    
    Accent 1
    Accent 1
    Section margin vertical
    Desktop
    
    Normal
    Normal
    Mobile
    
    Top none
    Top none
    
    Custom CSS, GEBNEREME PARA PODER METER DENTRO DE LA MARQUEE ITEM UN LINK

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-container-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .ai-marquee-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    width: 100%;
    overflow: hidden;
  }

  .ai-marquee-content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    white-space: nowrap;
    {% if block.settings.enable_animation %}
      animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
    {% endif %}
  }

  .ai-marquee-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    text-transform: {{ block.settings.text_transform }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .ai-marquee-item-{{ ai_gen_id }}:hover {
    color: {{ block.settings.text_hover_color }};
    text-decoration: {{ block.settings.hover_underline | default: 'none' }};
  }

  .ai-marquee-separator-{{ ai_gen_id }} {
    flex-shrink: 0;
    margin: 0 {{ block.settings.separator_spacing }}px;
    color: {{ block.settings.separator_color }};
    font-size: {{ block.settings.font_size }}px;
  }

  {% if block.settings.enable_animation %}
    @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-50%);
      }
    }

    .ai-marquee-content-{{ ai_gen_id }}:hover {
      animation-play-state: {{ block.settings.pause_on_hover | default: 'running' }};
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-marquee-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
      padding: {{ block.settings.vertical_padding | times: 0.8 }}px {{ block.settings.horizontal_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-marquee-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-marquee-wrapper-{{ ai_gen_id }}">
    <div class="ai-marquee-content-{{ ai_gen_id }}">
      {% liquid
        assign marquee_text = block.settings.marquee_text | default: 'Add your marquee text here'
        assign marquee_link = block.settings.marquee_link
        assign separator = block.settings.separator | default: '•'
        assign repeat_count = block.settings.repeat_count | default: 10%}

      {% for i in (1..repeat_count) %}
        {% if marquee_link != blank %}
          <a href="{{ marquee_link }}" class="ai-marquee-item-{{ ai_gen_id }}">{{ marquee_text }}</a>
        {% else %}
          <span class="ai-marquee-item-{{ ai_gen_id }}">{{ marquee_text }}</span>
        {% endif %}
        {% unless forloop.last %}
          <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ separator }}</span>
        {% endunless %}
      {% endfor %}

      {% if block.settings.enable_animation %}
        {% for i in (1..repeat_count) %}
          {% if marquee_link != blank %}
            <a href="{{ marquee_link }}" class="ai-marquee-item-{{ ai_gen_id }}">{{ marquee_text }}</a>
          {% else %}
            <span class="ai-marquee-item-{{ ai_gen_id }}">{{ marquee_text }}</span>
          {% endif %}
          {% unless forloop.last %}
            <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ separator }}</span>
          {% endunless %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Marquee text",
      "default": "Free shipping on orders over $50"
    },
    {
      "type": "url",
      "id": "marquee_link",
      "label": "Marquee link"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "default": "•"
    },
    {
      "type": "range",
      "id": "repeat_count",
      "min": 3,
      "max": 20,
      "step": 1,
      "label": "Text repetitions",
      "default": 8
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Enable animation",
      "default": true
    },
    {
      "type": "range",
      "id": "animation_speed",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "s",
      "label": "Animation speed",
      "default": 20,
      "info": "Higher numbers = slower animation"
    },
    {
      "type": "select",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "options": [
        {
          "value": "paused",
          "label": "Yes"
        },
        {
          "value": "running",
          "label": "No"
        }
      ],
      "default": "paused"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "label": "Letter spacing",
      "default": 0
    },
    {
      "type": "select",
      "id": "hover_underline",
      "label": "Underline on hover",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "underline",
          "label": "Underline"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "separator_spacing",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Separator spacing",
      "default": 20
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_hover_color",
      "label": "Text hover color",
      "default": "#e7307d"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e0e0e0"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Marquee"
    }
  ]
}
{% endschema %}