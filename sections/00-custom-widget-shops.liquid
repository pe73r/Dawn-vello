<div class="page-width" id="widget-container">
  <div id="{{ section.settings.widget_id }}"></div>

  <script>
    sc = document.createElement("script");
    sc.setAttribute("defer", true);
    sc.setAttribute(
      "src",
      "https://dbwx2z9xa7qt9.cloudfront.net/bundle.js?cachebust=1734518941392"
    );
    sc.setAttribute("theme", "light");
    sc.setAttribute("footer", "true");
    sc.setAttribute("widget-type", "carousel");
    sc.setAttribute("token", "{{ section.settings.widget_token }}");
    sc.setAttribute("apiurl", "https://server.onlinereviews.tech/api/v0.0.9");
    sc.setAttribute("stats", "true");
    sc.setAttribute("addReview", "true");
    sc.setAttribute("profile-pic", "true");
    sc.setAttribute("review-name", "true");
    sc.setAttribute("positive-stars", "false");
    sc.setAttribute("wl", "false");
    sc.setAttribute("wlndig", "https://go.climbo.com/albacete");
    sc.setAttribute("lang", "es");
    sc.setAttribute(
      "brandStyle",
      "%7B%22sidebar_background%22%3A%22%23E7307D%22%2C%22sidebar_text%22%3A%22%23ffffff%22%2C%22brand_button_text_color%22%3A%22white%22%2C%22brand_main_color%22%3A%22%23000000%22%2C%22brand_button_border_radius%22%3A%228px%22%2C%22brand_sidebar_text_color_opacity%22%3A%22%23ffffff1a%22%2C%22brand_button_hover%22%3A%22rgb(0%2C%200%2C%200)%22%2C%22brand_button_active%22%3A%22rgb(0%2C%200%2C%200)%22%2C%22brand_main_color_opacity%22%3A%22%230000001a%22%2C%22brand_font%22%3A%22Montserrat%2CInter%2CHelvetica%2CArial%2Csans-serif%22%2C%22star_color%22%3A%22%23128c7e%22%2C%22brand_main_background%22%3A%22%23F6F8F7%22%2C%22brand_card_background%22%3A%22white%22%2C%22poweredByLink%22%3A%22https%3A%2F%2Fsinvelloporlaser.es%22%2C%22poweredicon%22%3A%22https%3A%2F%2Frecensioni-io-static-folder.s3.eu-central-1.amazonaws.com%2Fpublic_onlinereviews%2Ffreemium%2F660e5ffdcef017008cb46ab0%2Fpowered.png%22%7D"
    );

    document.getElementById("{{ section.settings.widget_id }}").appendChild(sc);   
    
  </script>
</div>


{% schema %}
{
  "name": "Widget Display",
  "settings": [    
    {
      "type": "text",
      "id": "widget_id",
      "label": "Widget ID"
    },
    {
      "type": "text",
      "id": "widget_token",
      "label": "Widget Token"
    }
  ],
  "presets": [
    {
      "name": "Widget Display",
    }
  ]
}
{% endschema %}
