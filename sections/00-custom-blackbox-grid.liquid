{% schema %}
{
  "name": "Black Box Grid Blocks",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título",
      "default": "Inscríbete y asegúrate de tener las ofertas del <strong>Black Friday</strong> de Sinvello! <strong>¡72 horas solo para ti!</strong>"
    }
  ],
  "blocks": [
    {
      "type": "box",
      "name": "Black Box",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Título",
          "default": "<strong>Black</strong> Box"
        },
        {
          "type": "inline_richtext",
          "id": "subtitle",
          "label": "Subtítulo (tier)",
          "default": "GOLD"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Texto del botón",
          "default": "INSCRÍBETE"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Enlace del botón"
        },
        {
          "type": "text",
          "id": "spots_text",
          "label": "Texto superior contador",
          "default": "¡Solo quedan!"
        },
        {
          "type": "text",
          "id": "spots_count",
          "label": "Contador (ej: 150/200)",
          "default": "150/200"
        },
        {
          "type": "text",
          "id": "spots_label",
          "label": "Texto inferior contador",
          "default": "Plazas disponibles"
        },
        {
          "type": "checkbox",
          "id": "active",
          "label": "Activo",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Black Box Grid Blocks",
      "blocks": [
        {
          "type": "box",
          "settings": {
            "title": "Black Box",
            "subtitle": "GOLD",
            "active": true
          }
        },
        {
          "type": "box",
          "settings": {
            "title": "Black Box",
            "subtitle": "SILVER",
            "active": false
          }
        },
        {
          "type": "box",
          "settings": {
            "title": "Black Box",
            "subtitle": "BRONZE",
            "active": false
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
.black-box-section {
  padding: 20rem 1.5rem 10rem;
  text-align: center;  
  margin-top: -9rem;
}

.black-box-title {
  font-size: clamp(2rem, 5vi, 3.4rem);
  max-width: 720px;
  margin: 0 auto 5rem;
  line-height: 1.2;
  color: var(--custom-blau);
}

.black-box-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 3rem;
  max-width: var(--page-width);
  margin: 0 auto;
  padding: 0;
}

.black-box-item {
  padding: 2rem;
  border-radius: 0.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
  transition: all 0.3s ease;
}

.black-box-item.active {
  background-color: var(--custom-blau);
  color: white;
}

.black-box-item:not(.active) {
  background-color: #d0cfcf;
  color: #a6a5a5;
  pointer-events: none;
}

.box-title {
  font-size: 2.6rem;
  font-weight: 500;
  line-height: 1;
}

.box-subtitle {
  font-size: 5rem;
  font-weight: 700;
  line-height: 1;
}

.active .box-subtitle.oro {
  color: #fef05c;
}

.active .box-subtitle.plata {
  color: #d0cfcf;
}

.active .box-subtitle.bronce {
  color: #e79b5d;
}

.signup-button {
  border: 2px solid;
  text-transform: uppercase;
  font-weight: 500;
  text-decoration: none;
  color: #a6a5a5;
  border-radius: 3rem;
  padding: 1rem 7rem;
  margin: 3rem auto;
}
.active .signup-button{
  color: #fff;
}
.spots-counter {
  font-size: 2rem;
  font-weight: 700;
  padding: 0.75rem 7.5rem;
  line-height: 1;
  border: 1px solid currentColor;
  border-radius: 0.5rem;
}
.active .spots-counter{
  background-color: #fff;
  color: var(--custom-blau);
}
.spots-text {
  font-size: 1.8rem;
  margin-bottom: 0.5rem;
}

.spots-label {
  font-size: 1.8rem;
  margin-top: 0.5rem;
}
.black-box-item hr{
    margin: 0 auto;
    width: 40%;
    height: 1.5px;
    background-color: #a6a5a5;
}
.black-box-item.active hr{
    background-color: #fff;
}

@media (max-width: 768px) {
  .black-box-grid {
    grid-template-columns: 1fr;
    max-width: 400px;
  }
}
</style>

<div class="black-box-section" id="black-box-section-grid">
  <h2 class="black-box-title">
    {{ section.settings.title }}
  </h2>

  <div class="black-box-grid">
    {% for block in section.blocks %}
      {% if block.type == 'box' %}
        <div class="black-box-item {% if block.settings.active %}active{% endif %}" {{ block.shopify_attributes }}>
          <div>
            <div class="box-title">{{ block.settings.title }}</div>
            <div class="box-subtitle {{ block.settings.subtitle | downcase }}">
              {{ block.settings.subtitle }}
            </div>
          </div>

          <a href="{{ block.settings.button_url }}" class="signup-button">
            {{ block.settings.button_text }}
          </a>
          <hr />
          <div>
            <div class="spots-text">{{ block.settings.spots_text }}</div>
            <div class="spots-counter">{{ block.settings.spots_count }}</div>
            <div class="spots-label">{{ block.settings.spots_label }}</div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>