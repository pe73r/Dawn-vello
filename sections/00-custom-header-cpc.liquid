{% schema %}
{
  "name": "Header CPC",
  "limit": 1,
  "settings": [
    {
      "type": "select",
      "id": "text_position_desktop",
      "label": "Posición del Texto (Ordenador)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_position_mobile",
      "label": "Posición del Texto (Móvil)",
      "default": "top",
      "options": [
        {
          "value": "top",
          "label": "Arriba"
        },
        {
          "value": "bottom",
          "label": "Abajo"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Imagen de Fondo"
    }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "texto",
      "name": "Texto",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "titulo1",
          "label": "Título 1",
          "default": "Este es el título superior"
        },
        {
          "type": "inline_richtext",
          "id": "titulo2",
          "label": "Título 2",
          "default": "Este es el título inferior"
        },
        {
          "type": "richtext",
          "id": "descripcion",
          "label": "Descripción",
          "default": "<p>Este es el texto descriptivo.</p>"
        },
        {
          "type": "inline_richtext",
          "id": "adress",
          "label": "Dirección"
        },
        {
          "type": "inline_richtext",
          "id": "map_url_text",
          "label": "Texto de enlace de mapa"
        },        
        {
          "type": "url",
          "id": "map_url",
          "label": "Enlace de mapa"
        },        
        {
          "type": "inline_richtext",
          "id": "phone_text",
          "label": "Texto del télefono"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Télefono"
        },
        {
          "type": "inline_richtext",
          "id": "whatsapp_url_text",
          "label": "Texto del enlace de WhatsApp"
        },
        {
          "type": "text",
          "id": "info_boton_texto",
          "label": "Texto Informativo del Botón"
        },
        {
          "type": "text",
          "id": "boton_texto",
          "label": "Texto del Botón",
          "default": "Más información"
        },
        {
          "type": "url",
          "id": "url_boton",
          "label": "Enlace del Botón",          
        },
        {
          "type": "select",
          "id": "btn_style",
          "label": "Estilo boton",
          "default": "primary",
          "options": [
            {
              "value": "anchor",
              "label": "Enlace"
            },
            {
              "value": "primary",
              "label": "Primario"
            },
            {
              "value": "secondary",
              "label": "Secondario"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "transparent",
          "label": "Caja transparente",          
        },
        {
          "type": "checkbox",
          "id": "full_width",
          "label": "Caja al 100%",          
        },
        {
          "type": "select",
          "id": "out-center",
          "label": "Centrado de caja",
          "default": "center",
          "options": [
            {
              "value": "left",
              "label": "Izquierda"
            },
            {
              "value": "center",
              "label": "Centro"
            },
            {
              "value": "right",
              "label": "Derecha"
            }
          ]
        },
        {
          "type": "select",
          "id": "in-center",
          "label": "Centrado de texto",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "Izquierda"
            },
            {
              "value": "center",
              "label": "Centro"
            },
            {
              "value": "right",
              "label": "Derecha"
            }
          ]
        }
      ]
    },
    {
      "type": "media",
      "name": "Media",
      "settings": [
        {
          "type": "select",
          "id": "media_tipo",
          "label": "Tipo de Media",
          "default": "imagen",
          "options": [
            {
              "value": "imagen",
              "label": "Imagen"
            },
            {
              "value": "video",
              "label": "Video"
            }
          ]
        },
        {
          "type": "video",
          "id": "video_file",
          "label": "Archivo de Video",
          "info": "Cargue el archivo de video si ha seleccionado 'Video' como tipo de fondo."
        },
        {
          "type": "image_picker",
          "id": "image_url",
          "label": "Imagen de Fondo",
          "info": "Utilice esta opción si ha seleccionado 'Imagen' como tipo de fondo."
        },
        {
          "type": "select",
          "id": "img-center",
          "label": "Centrado de media",
          "default": "center",
          "options": [
            {
              "value": "left",
              "label": "Izquierda"
            },
            {
              "value": "center",
              "label": "Centro"
            },
            {
              "value": "right",
              "label": "Derecha"
            }
          ]
        },
        {
          "type": "select",
          "id": "media_height",
          "label": "Altura de media",
          "default": "400",
          "options": [
            {
              "value": "200",
              "label": "Pequeña"
            },
            {
              "value": "400",
              "label": "Mediana"
            },
            {
              "value": "600",
              "label": "Grande"
            }
          ]
        },
        {
          "type": "select",
          "id": "media_width",
          "label": "Anchura de media",
          "default": "60",
          "options": [
            {
              "value": "30",
              "label": "Pequeña"
            },
            {
              "value": "60",
              "label": "Mediana"
            },
            {
              "value": "100",
              "label": "Grande"
            }
          ]
        }
      ]
    },
    {
      "type": "form",
      "name": "Formulario",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "form_title",
          "label": "Título del formulario",
          "default": "Reserva ahora"
        },
        {
          "type": "richtext",
          "id": "form_description",
          "label": "Descripción del formulario",
          "default": "<p>Complete el formulario a continuación para realizar su reserva.</p>"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Texto del botón",
          "default": "Enviar"
        },
        {
          "type": "text",
          "id": "name_placeholder",
          "label": "Texto del campo 'Nombre'",
          "default": "Nombre*"
        },
        {
          "type": "text",
          "id": "phone_placeholder",
          "label": "Texto del campo 'Teléfono'",
          "default": "Teléfono*"
        },
        {
          "type": "text",
          "id": "email_placeholder",
          "label": "Texto del campo 'Email'",
          "default": "Email*"
        },
        {
          "type": "text",
          "id": "province_placeholder",
          "label": "Texto del campo 'Seleccionar Provincia'",
          "default": "Provincia*"
        },
        {
          "type": "text",
          "id": "center_placeholder",
          "label": "Texto del campo 'Seleccionar Centro'",
          "default": "Seleccione su centro"
        },
        {
          "type": "text",
          "id": "discount_placeholder",
          "label": "Texto del campo 'Seleccionar Descuento'",
          "default": "Elige tu descuento*"
        },
        {
          "type": "url",
          "id": "consent_url",
          "label": "URL de la Política de Privacidad"          
        },
        {
          "type": "text",
          "id": "consent_text",
          "label": "Texto del consentimiento",
          "default": "He leído y acepto la"
        },
        {
          "type": "text",
          "id": "consent_anchor_text",
          "label": "Texto del enlace del consentimiento",
          "default": "Política de Privacidad"
        }
        ,
        {
          "type": "text",
          "id": "currentCenter",
          "label": "Centro actual"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Header CPC",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<style>
  .custom-section {
    background-image: url(/cdn/shop/{{ section.settings.background_image | image_url: 'original' }});  
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
  }
  .custom-section .container{
    max-width: var(--page-width);
    padding: 5rem 2rem;
    margin: auto;
    display: grid;
    grid-template-columns: 48% 48%;
    align-items: center;
    grid-gap: 4%;
    {% if section.settings.text_position_desktop == "left" %}
    grid-template-areas: "first second";
    {% else %}
    grid-template-areas: "second first";
    {% endif %}
  }
  .t-text{
    grid-area: first;
    border-radius: 2rem;
    padding: 2rem 5rem;
    display: flex;
    flex-direction: column;
    align-items: start;
  }
  .t-text  h1 {
    text-align: start;
    font-size: 4em;
    margin-top: 2rem;
  }
  .t-text .title-1 {
    color: black;
  }
  .t-text .title-2 {
    font-weight: bold;
  }
  .t-text .adress,
  .t-text .phone{
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    gap: .5rem;
    margin: 2rem 0px;
  }
  .t-text .adress img,
  .t-text .phone img{
    width: 32px;
    height: 32px;
  }
  .t-text .adress .adress_text,
  .t-text .phone .phone_text{
    margin: 0;
    color: #fff;
    font-size: 1.8em;
  }
  .t-text .adress .map_url a,
  .t-text .phone .phone_url a{
    color: #fff !important;
    font-size: 1.2em;
  }
  .t-text .phone .phone_url a img{
    width: 20px;
    height: 20px;
  }
  .t-text .btn{
    text-decoration: none;
    background-color: rgba(var(--color-button),var(--alpha-button-background));
    color: rgb(var(--color-button-text));
    border-radius: 5rem;
    padding: 1.5rem 8rem;
    display: block;
    width: fit-content;
    font-size: 1.2em;
    background: var(--custom-gradient)
  }
  .t-text .btn-secondary{
    padding: 0.5rem 2rem;
    text-decoration: none;
    border-radius: 5px;
    background-color: transparent;
    border: 1px solid rgba(var(--color-foreground), .75);;
  }
  .t-text .btn-link{
    padding: 0.5rem 0;    
    background-color: transparent;
  }
  .t-text .btn-info {
    font-weight: bold;
    color: black;
    font-size: 1.1em;
    margin: 0;
    margin-top: 3rem;
  }
  .t-media{
    grid-area: second;
  }
  .t-media video{
    width: 100%;
  }
  .t-form{
     grid-area: second;
    display: flex;
    justify-content: end;
  }
  .form-box{
    border-radius: 3rem;
    padding: 2rem 4rem 5rem;
    text-align: center;
    box-shadow: 0px 0px 5px 0px #c3c3c3;
    max-width: 360px;
  }
  .t-form .form-box h2{
    font-size: 2em;
    color: var(--custom-rosa);
  }
  .t-form form{
    display: flex;
    flex-direction: column;
    gap: 2rem;
    justify-content: center;
    align-items: center;
  }
  .t-form form .field:after{
    box-shadow: none!important;
  }
  .t-form form .field .field__label,
  .t-form form .field .field__input,
  .t-form form .form-field label{
    color: black;
  }
  .t-form form .field .field__input{
    border: 1px solid black;
    box-shadow: none!important;
  }
  .t-form form .form-field a{
    color: var(--custom-rosa);
  }
  .t-form .contact__button{
    width: 100%;
  }
  .t-form .contact__button .button{
    background-color: var(--custom-rosa);
    color: #fff;
    border: none;
    transform: none!important;
    box-shadow: none!important;
    width: 100%;
  }
  .t-form .contact__button .button:after{
    box-shadow: none!important;
  }
  @media (max-width: 768px){
    .t-text  h1{
      text-align: center;
    }
    .t-text .desc{
      text-align: center;
    }
    .t-form{
      position: relative;
      right: 0rem;
      width: 100%;
    }
    .form-box{
      border-radius: 0;
      padding: 2rem 4rem 5rem;
      width: 100%;
      box-shadow: none;
    }
  }
  .t-form .select::after{
    content: '>';
    z-index: 1;
    top: 0.5rem;
    right: -80%;
    font-size: 24px;
    font-family: monospace;
    transform: rotate(90deg);
    font-weight: bold;         
  }
  .custom-checkbox {
      display: flex;
      align-items: start;
  }
  
  .custom-checkbox input[type="checkbox"] {
      appearance: none;
      -webkit-appearance: none;
      -moz-appearance: none;
      width: 24px;
      height: 18px;
      border: 1px solid #ddd;
      border-radius: 50%;
      outline: none;
      cursor: pointer;
      position: relative;
      margin: 0;
      margin-top: 0.5rem;
  }
  
  .custom-checkbox input[type="checkbox"]:checked {
      background-color: #fff;
      border: 1px solid #ff007f;
  }
  
  .custom-checkbox input[type="checkbox"]:checked::before {
      content: '\2713';
      font-size: 14px;
      color: #ff007f;
      position: absolute;
      top: -2px;
      left: 3px;
  }
  .custom-checkbox span{
      text-align: start;
      line-height: 1.2;
      margin-left: 1rem;
  }
  @media (max-width: 768px){
    .custom-section .container{
      grid-template-columns: auto;
      justify-content: center;
      padding: 5rem 0;
      {% if section.settings.text_position_mobile == "top" %}
      grid-template-areas: 
        "first" 
        "second";
      {% else %}
      grid-template-areas:         
        "second"
        "first";
      {% endif %}
    }
    .t-text{
      padding: 1rem;
    }
    .t-media img{
      height: 100%!important;
    }
  }
</style>

<section class="custom-section color-{{ section.settings.color_scheme }}">
  <div class="container">
    {% for block in section.blocks %}
      {% if block.type == 'texto' %}
        <div class="t-text {% if block.settings.transparent == false %}color-{{ section.settings.color_scheme }} gradient{% endif %}" style="text-align: {{ block.settings.in-center }};{% if block.settings.out-center == "center" %}margin: auto;{% endif %}{% if block.settings.out-center == "right" %}margin-left: auto;{% endif %}{% if block.settings.full_width %}width: 100%;{% else %}width: fit-content;{% endif %}">
          <h1>
            <span class="title-1">
              {{ block.settings.titulo1 }}
            </span>
            <br />
            <span class="title-2">
              {{ block.settings.titulo2 }}
            </span>
          </h1>          
          <div class="shop-info">
            {% if block.settings.adress != "" %}
              <div class="adress">
                <img src="https://cdn.shopify.com/s/files/1/0884/5865/8056/files/point.svg" alt="Point" width="32" height="32" />
                <p class="adress_text">{{ block.settings.adress }}</p>
                <p class="map_url"><a href="{{ block.settings.map_url }}" title="{{ block.settings.map_url_text }}">{{ block.settings.map_url_text }}</a></p>
              </div>
            {% endif %}

            {% if block.settings.phone != "" %}
               <div class="phone">
                <img src="https://cdn.shopify.com/s/files/1/0884/5865/8056/files/chat.svg" alt="Chat" width="32" height="32" />
                <p class="phone_text">{{ block.settings.phone_text }}</p>
                <p class="phone_text">{{ block.settings.phone }}</p>                
                <p class="phone_url">
                  <a href="https://wa.me/+34{{ block.settings.phone }}" title="{{ block.settings.whatsapp_url_text }}">
                    <img src="https://cdn.shopify.com/s/files/1/0884/5865/8056/files/whatsapp.svg" alt="Whatsapp" width="16" height="16" />
                    {{ block.settings.whatsapp_url_text }}
                  </a></p>
              </div>
            {% endif %}
          </div>
          <div class="desc">{{ block.settings.descripcion }}</div>

          {% if block.settings.info_boton_texto != "" %}
            <div class="btn-group">
              <p class="btn-info">{{ block.settings.info_boton_texto }}</p>
              {% if block.settings.btn_style == "primary" %}
              <a href="{{ block.settings.url_boton }}" class="btn color-{{ section.settings.color_scheme }}">{{ block.settings.boton_texto }}</a>
              {% elsif block.settings.btn_style == "secondary"  %}
              <a href="{{ block.settings.url_boton }}" class="btn-secondary color-{{ section.settings.color_scheme }}">{{ block.settings.boton_texto }}</a>
              {% else %}
              <a href="{{ block.settings.url_boton }}" class="btn-link color-{{ section.settings.color_scheme }}">{{ block.settings.boton_texto }}</a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.type == 'media' %}
        <div class="t-media" style="display: flex; justify-content: {{ block.settings.img-center }};">
          {% if block.settings.media_tipo == 'imagen' %}
            {% if block.settings.image_url %}
              <img src="/cdn/shop/{{ block.settings.image_url | image_url: 'master' }}" alt="Imagen" width="300" height="{{ block.settings.media_height }}" style="width: {{ block.settings.media_width }}%; object-fit:cover;">
            {% endif %}
          {% elsif block.settings.media_tipo == 'video' %}
            {% if block.settings.video_file %}
              <div style="width: {{ block.settings.media_width }}%; height: {{ block.settings.media_height }}px; display: flex; align-items: center;">
                {{ block.settings.video_file | video_tag: autoplay: true, muted: true, loop: true }}
              </div>
            {% endif %}
          {% endif %}
        </div>
      {% endif %}
      
      {% if block.type == 'form' %}
        <div class="t-form">
          <div class="color-{{ section.settings.color_scheme }} gradient form-box">
            <h2>{{ block.settings.form_title }}</h2>
            <p>{{ block.settings.form_description }}</p>
            
            {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
              <input type="hidden" name="contact[title]" value="cupon-form">
              {%- if form.posted_successfully? -%}
                <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
                  {% render 'icon-success' %}
                  {{ 'templates.contact.form.post_success' | t }}
                </h2>
              {%- elsif form.errors -%}
                <div class="form__message">
                  <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                    {% render 'icon-error' %}
                    {{ 'templates.contact.form.error_heading' | t }}
                  </h2>
                </div>
                <ul class="form-status-list caption-large" role="list">
                  <li>
                    <a href="#ContactForm-email" class="link">
                      {{ form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email }}
                    </a>
                  </li>
                </ul>
              {%- endif -%}
              <div class="field">
                <input
                  class="field__input"
                  autocomplete="name"
                  type="text"
                  id="ContactForm-name"
                  name="contact[{{ block.settings.name_placeholder }}]"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  placeholder="{{ block.settings.name_placeholder }}"
                >
                <label class="field__label" for="ContactForm-name">{{ block.settings.name_placeholder }}</label>
              </div>
              <div class="field">              
                <input
                  type="tel"
                  id="ContactForm-phone"
                  class="field__input"
                  autocomplete="tel"
                  name="contact[{{ block.settings.phone_placeholder }}]"
                  pattern="[0-9\-]*"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  placeholder="{{ block.settings.phone_placeholder }}"
                >
                <label class="field__label" for="ContactForm-phone">{{ block.settings.phone_placeholder }}</label>
              </div>
              <div class="field field--with-error">
                <input
                  autocomplete="email"
                  type="email"
                  id="ContactForm-email"
                  class="field__input"
                  name="contact[email]"
                  spellcheck="false"
                  autocapitalize="off"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  aria-required="true"
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="ContactForm-email-error"
                  {% endif %}
                  placeholder="{{ block.settings.email_placeholder }}"
                >
                <label class="field__label" for="ContactForm-email">
                  {{ block.settings.email_placeholder }}</label>
                {%- if form.errors contains 'email' -%}
                  <small class="contact__field-error" id="ContactForm-email-error">
                    <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                    <span class="form__message">
                      {%- render 'icon-error' -%}
                      {{- form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email -}}
                    </span>
                  </small>
                {%- endif -%}
              </div>
              <div class="field select">
                <select
                  style="padding: 0.8rem 1.5rem .8rem 2rem;"
                  class="field__input"
                  id="ContactForm-province"
                  name="contact[{{ block.settings.province_placeholder }}]"
                  value="{% if form.province %}{{ form.province }}{% elsif customer %}{{ customer.province }}{% endif %}"                
                >
                  <option value="" disabled selected>{{ block.settings.province_placeholder }}</option>
                  {% paginate shop.metaobjects.provincia.values by 999 %}        
                    {% for item in shop.metaobjects.provincia.values %}
                      <option value="{{ item.nombre.value }}">
                         {{ item.nombre.value }}                    
                      </option>
                    {% endfor %}
                  {% endpaginate %}
                </select>
                <label class="field__label" style="display: none;" for="ContactForm-province">{{ block.settings.province_placeholder }}</label>
              </div>
              <div class="field select">
                <select
                  style="padding: 0.8rem 1.5rem .8rem 2rem;"
                  class="field__input"
                  id="ContactForm-center"
                  name="contact[{{ block.settings.center_placeholder }}]"
                  value="{% if form.center %}{{ form.center }}{% elsif customer %}{{ customer.center }}{% endif %}"                
                >
                   <option value="" disabled selected>
                     {{ block.settings.center_placeholder }}                    
                  </option>
                  
                </select>
                <label class="field__label" style="display: none;" for="ContactForm-center">{{ block.settings.center_placeholder }}</label>
              </div>
              <div class="field select">
                <select
                  style="padding: 0.8rem 1.5rem .8rem 2rem;"
                  class="field__input"
                  id="ContactForm-discount"
                  name="contact[{{ block.settings.discount_placeholder }}]"
                  value="{% if form.discount %}{{ form.discount }}{% elsif customer %}{{ customer.discount }}{% endif %}"                
                >
                   <option value="" disabled selected>{{ block.settings.discount_placeholder }}</option>
                    {% for item in shop.metaobjects.descuento.values %}
                      <option value="{{ item.valor.value }}">
                         {{ item.nombre.value }}                    
                      </option>
                    {% endfor %}
                </select>
                <label class="field__label" style="display: none;" for="ContactForm-discount">{{ block.settings.discount_placeholder }}</label>
              </div>
              
              <div class="form-field">
                <label class="custom-checkbox">
                  <input type="checkbox" name="contact[consent]" required>
                  <span>
                    {{ block.settings.consent_text }}
                    <a class="color-{{ section.settings.color_scheme }}" href="{{ block.settings.consent_url }}" target="_blank" style="background-color: transparent;">{{ block.settings.consent_anchor_text }}</a>
                  </span>
                </label>
              </div>
              <div class="contact__button">
                <button type="submit" class="button color-{{ section.settings.color_scheme }}">
                  {{ block.settings.button_text }}
                </button>
              </div>            
            {% endform %}
          </div>
        </div>
        <script>
            var currentCenter = "{{ block.settings.currentCenter }}";
            {% paginate shop.metaobjects.tiendas.values by 999 %}
              var centers = [
                {% for tienda in shop.metaobjects.tiendas.values %}
                  { nombre: "{{ tienda.nombre }}", provincia: "{{ tienda.provincia_1.value.nombre }}" }{% if forloop.last == false %},{% endif %}
                {% endfor %}
              ];
            {% endpaginate %}
            var selectCenter = document.getElementById("ContactForm-center");  
            var selectProvince = document.getElementById("ContactForm-province");  
            selectProvince.addEventListener("change", function(){
              if (selectProvince.value == "") return;
              var filteredCenters = centers.filter(function(center) {
                return center.provincia === selectProvince.value;
              });
              while (selectCenter.options.length > 1) {
                selectCenter.remove(1);
              }
              filteredCenters.forEach(center => {
                var option = document.createElement("option");
                option.value = center.nombre;
                option.textContent = center.nombre;
                selectCenter.appendChild(option);
              });
            }); 

            var selectedCenter = centers.find((element) => element.nombre == currentCenter);

            if(selectedCenter){
              selectProvince.value = selectedCenter.provincia;
              var event = new Event('change');
              selectProvince.dispatchEvent(event);
              selectCenter.value = selectedCenter.nombre;
            }
            
          </script>
      {% endif %}
      {% if block.type == '@app' %}
        <div class="t-form">
          {% render block %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>
