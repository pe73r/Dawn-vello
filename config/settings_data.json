  "platform_customizations": {
    "custom_css": [
      ".icon-wrap {display: none;}",
      ".multicolumn .link {margin: 0; border-radius: 5rem; padding: 1.5rem 5rem; border: 2px solid transparent; font-size: 1.1em; line-height: 1;}",
      ".collection .subtitle {text-align: center; color: var(--custom-blau); margin-top: 2rem;}",
      ".collection .card__badge {position: absolute; top: 0; grid-row-start: auto; background-color: var(--custom-rosa); border-radius: 0 0 5px 5px; left: 3rem; text-transform: uppercase; height: 28px;}",
      ".collection .card__badge span {background-color: transparent; border: none; font-size: 0.9em;}",
      ".collection .grid__item {border-radius: 3rem; overflow: hidden; box-shadow: 0px 0px 5px 0px #ddd;}",
      ".collection .button {text-transform: uppercase; width: fit-content; margin: 3rem auto !important; display: flex; padding: 1rem 8rem; font-size: 1.2em;}",
      ".collection .grid__item h3 {font-size: 1.1em; color: #000; line-height: 1;}",
      ".grid .card-desc {color: #6a6a6a;}",
      ".grid .price-item--last {color: #000; font-size: 1.2em; font-weight: bold;}",
      ".grid .price__sale .price-item--regular {color: red; font-size: 1em;}",
      ".grid .price__regular .price-item--regular {font-size: 1.2em; font-weight: bold; color: #000;}",
      ".list-social {justify-content: center !important; margin: 3rem auto 1rem;}",
      ".list-social__item .icon {height: 3.2rem; width: 3.2rem;}",
      ".footer__content-bottom {display: none;}",
      ".porcent {color: #fff; background-color: var(--custom-blau) !important; padding: 0.5rem; border-bottom-right-radius: 5px; font-weight: bold;}",
      ".article-template__back {display: none;}",
      ".product__title h1 {font-size: 24px; font-weight: bold;}",
      ".product_price {font-size: 32px; font-weight: bold;}",
      ".slider {padding: 2rem 0;}"
    ]
  }
